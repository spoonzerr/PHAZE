# Copy this file to .env and fill in your keys. Never commit .env.

# --- Required for AI features: Nebius Token Factory (https://tokenfactory.nebius.com) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model IDs: copy the exact names from the Token Factory model list
NEMOTRON_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b

# Prices in USD per 1M tokens (for the cost estimate in "Under the hood")
NANO_PRICE_IN=0.06
NANO_PRICE_OUT=0.24
SUPER_PRICE_IN=
SUPER_PRICE_OUT=

# --- Optional: web search for the Haze news tab and the Ask tab (https://tavily.com) ---
TAVILY_API_KEY=

# --- Optional: phone notifications via Telegram (see README) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: data.gov.sg API key for higher rate limits on Singapore PSI ---
DATA_GOV_SG_API_KEY=
